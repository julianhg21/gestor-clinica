server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 2m;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    resolver_timeout 5s;
    set $auth_backend auth.railway.internal:${AUTH_PORT};
    set $pedidos_backend pedidos.railway.internal:${PEDIDOS_PORT};
    proxy_connect_timeout 5s;

    # Local Compose defaults to port 8000; Railway injects each API's PORT
    # through reference variables on the web service.
    location /api/auth/ {
        proxy_pass http://$auth_backend;
        proxy_set_header Host $host;
    }

    location /api/users {
        proxy_pass http://$auth_backend;
        proxy_set_header Host $host;
    }

    location /api/roles {
        proxy_pass http://$auth_backend;
        proxy_set_header Host $host;
    }

    location /api/catalogo/ {
        proxy_pass http://$auth_backend;
        proxy_set_header Host $host;
    }

    location /api/pedidos {
        proxy_pass http://$pedidos_backend;
        proxy_set_header Host $host;
    }

    location /api/pagos {
        proxy_pass http://$pedidos_backend;
        proxy_set_header Host $host;
    }

    location /api/metodos-pago {
        proxy_pass http://$pedidos_backend;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
