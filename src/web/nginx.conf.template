server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 2m;

    # Local Compose defaults to port 8000; Railway injects each API's PORT
    # through reference variables on the web service.
    location /api/auth/ {
        proxy_pass http://auth.railway.internal:${AUTH_PORT}/api/auth/;
        proxy_set_header Host $host;
    }

    location /api/users {
        proxy_pass http://auth.railway.internal:${AUTH_PORT}/api/users;
        proxy_set_header Host $host;
    }

    location /api/roles {
        proxy_pass http://auth.railway.internal:${AUTH_PORT}/api/roles;
        proxy_set_header Host $host;
    }

    location /api/catalogo/ {
        proxy_pass http://auth.railway.internal:${AUTH_PORT}/api/catalogo/;
        proxy_set_header Host $host;
    }

    location /api/pedidos {
        proxy_pass http://pedidos.railway.internal:${PEDIDOS_PORT}/api/pedidos;
        proxy_set_header Host $host;
    }

    location /api/pagos {
        proxy_pass http://pedidos.railway.internal:${PEDIDOS_PORT}/api/pagos;
        proxy_set_header Host $host;
    }

    location /api/metodos-pago {
        proxy_pass http://pedidos.railway.internal:${PEDIDOS_PORT}/api/metodos-pago;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
