# PostgreSQL
POSTGRES_DB=duality
POSTGRES_USER=duality
POSTGRES_PASSWORD=change-this-postgres-password

# Shared application configuration
JWT_SECRET=change-this-with-at-least-32-random-characters
JWT_EXP_MINUTES=480
REDIS_URL=redis://redis:6379/0

# Development CORS; use the real origin in production
CORS_ORIGINS=http://localhost:8080
